# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...mais on versionne l'exemple (sans secrets)
!.env.local.example

# secrets / donnees sensibles (jamais sur GitHub)
*credentials*
*.key


/docs/*.pdf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Rapports d'audit exportés (MDN Observatory, securityheaders, PageSpeed, Lighthouse)
# — des sorties d'outils, pas du code : elles n'ont pas à vivre dans le dépôt.
*.pdf


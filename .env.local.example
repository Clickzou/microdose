# ============================================================
#  Variables d'environnement — bien-microdose.com
#  Copier en .env.local (jamais versionné) et, pour la prod, les saisir dans
#  Vercel > Settings > Environment Variables.
# ============================================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://bien-microdose.com
# Le site se met seul en noindex hors production Vercel et sur *.vercel.app.
# NEXT_PUBLIC_ALLOW_INDEXING=false

# Pays ouverts à la livraison (codes ISO, séparés par des virgules). Vide = les 8
# zones de l'ancienne boutique : NL,BE,DE,FR,LU,IT,PT,ES.
# ⚠ Décision juridique : statut de la psilocybine selon le pays (audit, point 3).
NEXT_PUBLIC_SHIPPING_COUNTRIES=NL

# --- Supabase (commandes, contacts, newsletter) — projet DÉDIÉ, région UE ---
SUPABASE_URL=
# Clé de service : serveur uniquement, ne jamais la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- CardGate (paiement) ---
# Back-office CardGate : Merchant ID + API key (compte), Site ID + Site key
# (hash key du site, sert à vérifier les callbacks). Mode test par défaut :
# passer CARDGATE_TEST_MODE=false en production seulement.
CARDGATE_MERCHANT_ID=
CARDGATE_API_KEY=
CARDGATE_SITE_ID=
CARDGATE_SITE_KEY=
CARDGATE_TEST_MODE=true

# --- E-mails de commande (Resend) ---
# Envoyés quand une commande passe à « payée » : confirmation au client, notification
# à BIEN. Sans clé ni expéditeur, aucun e-mail ne part (le paiement fonctionne quand même).
RESEND_API_KEY=
# Adresse sur un domaine validé dans Resend.
EMAIL_FROM=BIEN <orders@bien.health>
# Défaut des deux suivantes : info@bien.health
# EMAIL_REPLY_TO=info@bien.health
# ORDER_NOTIFY_EMAIL=info@bien.health

# --- Tableau de bord "SEO by Clickzou" (/seo) - outil interne ---
# Mêmes identifiants que bien.health. Le mot de passe n'est écrit nulle part dans
# le dépôt (public) : sans SEO_DASHBOARD_PASSWORD, le tableau de bord reste fermé.
# Identifiant par défaut : carla07stats (SEO_DASHBOARD_USER pour le changer).
SEO_DASHBOARD_PASSWORD=
# Compte de service Google (le même que bien.health), JSON encodé en base64 :
#   - dans GA4 : Admin > Gestion des acces a la propriete, role Lecteur
#   - dans Search Console : Utilisateurs et autorisations, autorisation Complete
GOOGLE_SERVICE_ACCOUNT_JSON=
# Identifiant NUMERIQUE de la propriete GA4 (Admin > Details de la propriete).
GA4_PROPERTY_ID=
# Seulement si la propriete Search Console n'est pas sc-domain:bien-microdose.com
# GSC_SITE_URL=

# --- Mesure (chargée uniquement après consentement cookies) ---
# Propriété GA4 PROPRE à ce site : ne pas réutiliser celle de bien.health.
NEXT_PUBLIC_GA_ID=

# --- Blog ---
# Les articles en compliance "review" ne sont publiés en production qu'avec true.
# À ne passer à true qu'après validation juridique.
# PUBLISH_REVIEW_ARTICLES=false
